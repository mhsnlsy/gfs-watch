{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gfs-watch-web",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__health",
      "/gfs/*",
      "/api/*",
      "/data/notifications/*",
      "/data/ecmwf/*",
      "/data/istanbul-gfs-*",
      "/koy-data/gfs/*"
    ],
    "not_found_handling": "404-page"
  },
  "services": [
    {
      "binding": "ISTANBUL_GFS",
      "service": "gfs-watch-istanbul-gfs"
    },
    {
      "binding": "KOY_GFS",
      "service": "gfs-watch-koy-gfs"
    },
    {
      "binding": "STATIONS",
      "service": "gfs-watch-stations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIVE_ARCHIVE",
      "bucket_name": "gfs-watch-live-archive"
    }
  ]
}
