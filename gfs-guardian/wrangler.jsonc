{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gfs-watch-gfs-guardian",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "5,15,25,35,45,55 * * * *"
    ]
  },
  "services": [
    {
      "binding": "ISTANBUL_GFS",
      "service": "gfs-watch-istanbul-gfs"
    }
  ]
}
