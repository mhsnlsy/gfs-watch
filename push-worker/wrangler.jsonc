{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gfs-watch-push",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://gfs-watch-web.muhsin-ulusoy.workers.dev",
    "VAPID_SUBJECT": "https://gfs-watch-web.muhsin-ulusoy.workers.dev/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gfs-watch-push",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["45 16 * * *"]
  }
}
