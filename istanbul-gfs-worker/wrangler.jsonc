{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gfs-watch-istanbul-gfs",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "r2_buckets": [
    {
      "binding": "ECMWF_ARCHIVE",
      "bucket_name": "gfs-watch-live-archive"
    }
  ],
  "d1_databases": [
    {
      "binding": "GFS_DB",
      "database_name": "gfs-watch-istanbul-gfs",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
